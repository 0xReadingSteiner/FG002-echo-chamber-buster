{
  "manifest_version": 3,
  "name": "Echo Chamber Buster",
  "short_name": "ECB",
  "version": "1.0.0",
  "description": "Bot & astroturf identification for Reddit archive data. Full-history scan of dark gaps, bursts, duplicate slop and community bot-accusations — clean datasets before training.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://reddit.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://arctic-shift.photon-reddit.com/*",
    "https://api.pullpush.io/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reddit.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "signals.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
